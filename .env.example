# ==============================================================================
# FiberOps - Environment Variables Template
# Copy this file to .env.local for local development or .env for production
# ==============================================================================

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://fiberops:fiberops_secure_pass@localhost:5432/fiberops_db?schema=public"

# Redis (Caching & Real-time Pub/Sub)
REDIS_URL="redis://localhost:6379"

# MinIO Object Storage (S3-compatible)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="fiberops_minio_admin"
MINIO_SECRET_KEY="fiberops_minio_secret_pass"
MINIO_BUCKET="fiberops-proofs"

# Ollama / Local LLM (Agentic AI Engine)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Security & Sessions
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
SESSION_EXPIRY_SECONDS=28800
HMAC_ACTION_SECRET="replace-with-a-secure-random-32-byte-hex-secret"

# Mobile App Minimum Supported Version
MIN_MOBILE_APP_VERSION="1.0.0"
