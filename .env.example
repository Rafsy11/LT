# ==============================================================================
# FiberOps - Environment Variables Template
# Copy this file to .env.local for local development or .env for production
# Configured for Apple Silicon M5 (10-core CPU/GPU, 24GB Unified RAM, macOS ARM64)
# ==============================================================================

# Reverse Proxy & Host Port (Avoids macOS privileged port 80 conflicts)
WEB_HTTP_PORT=8080

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://fiberops:fiberops_secure_pass@localhost:5432/fiberops_db?schema=public"
SEED_DEFAULT_PASSWORD="FiberOps#2026"

# Redis (Caching & Real-time Pub/Sub)
REDIS_URL="redis://localhost:6379"

# MinIO Object Storage (S3-compatible)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="fiberops_minio_admin"
MINIO_SECRET_KEY="fiberops_minio_secret_pass"
MINIO_BUCKET="fiberops-proofs"
# Public-facing MinIO URL for mobile client uploads & browser access (via Nginx /s3/ proxy)
MINIO_PUBLIC_URL="http://localhost:8080/s3"

# Ollama / Local LLM (Agentic AI Engine - Native macOS Metal GPU)
# IMPORTANT: Do NOT include trailing /api
# Inside Docker container use: http://host.docker.internal:11434
# Local host development use: http://localhost:11434
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Nginx Gateway Health Probe (used by Next.js system telemetry)
NGINX_HEALTH_URL="http://127.0.0.1:8080/api/v1/health"

# Security & Sessions
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
SESSION_EXPIRY_SECONDS=28800
HMAC_ACTION_SECRET="replace-with-a-secure-random-32-byte-hex-secret"

# Telegram Bot 2FA OTP (supports comma-separated Chat IDs for multi-contributor teams, e.g. "7072749677,123456789")
TELEGRAM_BOT_TOKEN="replace-with-telegram-bot-token-from-botfather"
TELEGRAM_BOT_USERNAME="FiberOpsNOCBot"
TELEGRAM_DEFAULT_CHAT_ID=""

# Mobile App Minimum Supported Version
MIN_MOBILE_APP_VERSION="1.0.0"

# Fail-fast mode (true = disable mock fallbacks and return HTTP 503 if DB/infra unavailable)
STRICT_LIVE_DATA="true"
