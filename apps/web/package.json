{
  "name": "@repo/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test:security": "tsx --tsconfig tsconfig.json ../../scripts/security-audit.ts",
    "test:e2e": "tsx --tsconfig tsconfig.json --test \"../../tests/e2e/**/*.test.ts\"",
    "test:e2e:tier1": "tsx --tsconfig tsconfig.json --test \"../../tests/e2e/tier1-feature-coverage/**/*.test.ts\"",
    "test:e2e:tier2": "tsx --tsconfig tsconfig.json --test \"../../tests/e2e/tier2-boundary-corner/**/*.test.ts\"",
    "test:e2e:tier3": "tsx --tsconfig tsconfig.json --test \"../../tests/e2e/tier3-cross-feature/**/*.test.ts\"",
    "test:e2e:tier4": "tsx --tsconfig tsconfig.json --test \"../../tests/e2e/tier4-workload-scenarios/**/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "ai": "^7.0.179",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "minio": "^8.0.7",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
