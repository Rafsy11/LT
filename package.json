{
  "name": "isp-ops-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:security": "pnpm --filter @repo/web run test:security",
    "test:e2e": "pnpm --filter @repo/web run test:e2e",
    "test:e2e:tier1": "pnpm --filter @repo/web run test:e2e:tier1",
    "test:e2e:tier2": "pnpm --filter @repo/web run test:e2e:tier2",
    "test:e2e:tier3": "pnpm --filter @repo/web run test:e2e:tier3",
    "test:e2e:tier4": "pnpm --filter @repo/web run test:e2e:tier4",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @repo/database run db:generate",
    "db:push": "pnpm --filter @repo/database run db:push",
    "db:seed": "pnpm --filter @repo/database run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.2"
  },
  "packageManager": "pnpm@12.11.2"
}
